*.ilp

# ─── Raw data (not committed — too large and/or proprietary) ──────────────────
# Use * not trailing / so .gitkeep files inside can be tracked via ! negations
data/raw/*
!data/raw/.gitkeep
data/clean/*
!data/clean/.gitkeep
data/clean_bloomberg/*
!data/clean_bloomberg/.gitkeep
data/results/*
!data/results/.gitkeep
data/results_simulated/*
!data/results_simulated/.gitkeep
data/results_bloomberg/*
!data/results_bloomberg/.gitkeep

# ─── Generated figures (regenerated by pipeline) ─────────────────────────────
figures/*
!figures/.gitkeep

# ─── Console output logs (regenerated by pipeline) ───────────────────────────
output/
outputs/
*.log

# ─── NumPy binary files (large; regenerated by step 2 / step 6) ──────────────
*.npy

# ─── IDE and editor files ─────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Windows ──────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Jupyter notebooks (intermediate exploration, not part of pipeline) ───────
.ipynb_checkpoints/
*.ipynb

# ─── pytest / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.cover

# ─── mypy / type-checking ─────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# Local tool configuration (not committed)
.claude/
*.local.json
